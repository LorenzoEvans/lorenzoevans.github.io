---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const projects = await getCollection('projects');
const allContent = [...posts, ...projects];

const tags = [...new Set(allContent.flatMap(item => item.data.tags))];
const tagCounts = tags.reduce((acc, tag) => {
  acc[tag] = allContent.filter(item => item.data.tags.includes(tag)).length;
  return acc;
}, {} as Record<string, number>);
---

<Layout title="Tags - Lorenzo's Portfolio">
	<main>
		<h1>Tags</h1>
		<div class="tags-grid">
			{tags.map(tag => (
				<a href={`/tags/${tag}`} class="tag">
					<span class="name">{tag}</span>
					<span class="count">{tagCounts[tag]}</span>
				</a>
			))}
		</div>
	</main>
</Layout>

<style>
	main {
		width: 100%;
		padding: clamp(1rem, 4vw, 2rem);
		max-width: 1400px;
		margin: 0 auto;
	}
	h1 {
		margin-bottom: 2rem;
		color: var(--text-primary);
	}
	.tags-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
		gap: clamp(1rem, 3vw, 2rem);
	}
	.tag {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem;
		background: white;
		border: 1px solid var(--accent);
		border-radius: 4px;
		text-decoration: none;
		color: var(--text-primary);
		transition: transform 0.2s ease;
	}
	.tag:hover {
		transform: translateY(-2px);
	}
	.count {
		background: var(--accent);
		color: white;
		padding: 0.25rem 0.5rem;
		border-radius: 999px;
		font-size: 0.875rem;
	}
</style>
