---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const projects = await getCollection('projects');
  const allContent = [...posts, ...projects];
  const tags = [...new Set(allContent.flatMap(item => item.data.tags))];
  
  return tags.map(tag => ({
    params: { tag },
    props: { 
      items: allContent.filter(item => item.data.tags.includes(tag)),
      tag 
    },
  }));
}

const { items, tag } = Astro.props;
---

<Layout title={`Content tagged with "${tag}" - Eco Blog`}>
	<main>
		<h1>Content tagged with "{tag}"</h1>
		<div class="blog-grid">
			{items.map(item => (
				<a href={item.collection === 'projects' ? `/projects/${item.slug}` : `/${item.slug}`} class="card-link">
					<BlogCard
						title={item.data.title}
						description={item.data.description}
						image={item.data.image}
					/>
				</a>
			))}
		</div>
	</main>
</Layout>

<style>
	main {
		padding: 2rem;
		max-width: 1400px;
		margin: 0 auto;
	}
	h1 {
		margin-bottom: 2rem;
		color: var(--text-primary);
	}
	.blog-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 2rem;
	}
	.card-link {
		text-decoration: none;
	}
	@media (max-width: 1200px) {
		.blog-grid {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	@media (max-width: 900px) {
		.blog-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.blog-grid {
			grid-template-columns: 1fr;
		}
	}
</style>