---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
// Sort by pubDate descending
projects.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="Projects | Lorenzo's Portfolio">
	<main>
		<h1>My Projects</h1>
		<div class="projects-grid">
			{projects.map(project => (
				<a href={`/projects/${project.slug}`} class="card-link">
					<BlogCard
						title={project.data.title}
						description={project.data.description}
						image={project.data.image}
					/>
				</a>
			))}
		</div>
	</main>
</Layout>

<style>
	main {
		width: min(1400px, calc(100% - var(--page-gutter) - var(--page-gutter)));
		padding: clamp(1.25rem, 4vw, 2rem) 0;
		margin: 0 auto;
	}
	h1 {
		font-size: clamp(1.8rem, 7vw, 2.5rem);
		margin: 0 0 clamp(1.25rem, 4vw, 2rem);
		color: var(--text-primary);
	}
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
		gap: clamp(1rem, 3vw, 2rem);
	}
	.card-link {
		text-decoration: none;
	}
</style>
