---
import { getCollection } from 'astro:content';
import 'katex/dist/katex.min.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
const pages = await getCollection('page');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Lorenzo's Portfolio" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<div class="header-inner">
				<nav>
					<div class="nav-left">
						<a href="/" class="logo">
							<svg width="40" height="40" viewBox="0 0 40 40" fill="none">
								<circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
								<path d="M12 20C12 25 16 28 20 28C24 28 28 25 28 20C28 15 24 12 20 12" stroke="currentColor" stroke-width="2"/>
							</svg>
							<h1>Lorenzo Evans</h1>
						</a>
					</div>
					<div class="nav-right">
						<a href="/projects" class="nav-link">Projects</a>
						<a href="/tags" class="nav-link">Tags</a>
						{pages.map(page => (
							<a href={`/${page.slug}`} class="nav-link">{page.data.title}</a>
						))}
					</div>
				</nav>
				</div>
				<div class="header-rule" aria-hidden="true"></div>
			</div>
		</header>
		<slot />
		<footer>
			<p>&copy; Lorenzo Evans. </p>
		</footer>
	</body>
</html>
<style>
	:root {
		--text-primary: #1a1a1a;
		--text-secondary: #4a4a4a;
		--background: #f5f5f5;
		--accent: #2d2d2d;
		--page-gutter: clamp(1rem, 4vw, 2rem);
	}
	html {
		font-family: system-ui, sans-serif;
		background: var(--background);
		color: var(--text-primary);
		-webkit-text-size-adjust: 100%;
		box-sizing: border-box;
	}
	:global(*), :global(*::before), :global(*::after) {
		box-sizing: inherit;
	}
	body {
		margin: 0;
		padding: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		overflow-x: clip;
	}
	header {
		padding: var(--page-gutter) 0 0;
	}
	.header-inner {
		width: min(1400px, calc(100% - var(--page-gutter) - var(--page-gutter)));
		margin: 0 auto;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		row-gap: 0.75rem;
		width: 100%;
	}
	.nav-left, .nav-right {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
	}
	.logo {
		display: flex;
		align-items: center;
		gap: 1rem;
		color: var(--text-primary);
		text-decoration: none;
	}
	.logo svg {
		flex: none;
	}
	.logo:hover {
		opacity: 0.8;
	}
	.logo h1 {
		margin: 0;
		font-size: clamp(1.15rem, 4vw, 1.5rem);
	}
	.nav-link {
		color: var(--text-primary);
		text-decoration: none;
		font-weight: 500;
		padding: 0.5rem clamp(0.35rem, 2vw, 1rem);
		border-radius: 4px;
		transition: background-color 0.2s ease;
	}
	.nav-link:hover {
		background-color: rgba(0, 0, 0, 0.05);
	}
	.header-rule {
		height: 1px;
		margin-top: var(--page-gutter);
		background: var(--accent);
	}
	footer {
		margin-top: auto;
		padding: clamp(1.25rem, 4vw, 2rem);
		text-align: center;
		border-top: 1px solid var(--accent);
		color: var(--text-secondary);
	}
	@media (max-width: 600px) {
		nav {
			align-items: flex-start;
		}
		.nav-left {
			width: 100%;
		}
		.nav-right {
			width: 100%;
			gap: 0.25rem 0.5rem;
		}
		.nav-link {
			padding-inline: 0.5rem;
		}
	}
</style>
